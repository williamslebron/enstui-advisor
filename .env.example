# =============================================================================
# .env  —  Copy to .env and fill in the values before running bootstrap.
# NEVER commit this file to GitHub.
# =============================================================================

# ── Required: YouTube Scraper ────────────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_api_key_here

# ── Required: Supabase (vector DB) ───────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ── Required: Gemini (chat + embeddings + vision) ────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the default chat / vision model
GEMINI_CHAT_MODEL=gemini-2.5-flash
# Options: gemini-2.5-flash (fast, free tier friendly)
#          gemini-2.5-pro   (smartest, tighter free quota)

# Optional: override the default embedding model
GEMINI_EMBED_MODEL=text-embedding-004

# ── Optional: Password gate for the Streamlit app ─────────────────────────────
# If set, visitors must enter this password to use the app.
# Leave blank for open access (local dev). REQUIRED if deploying to the public internet.
APP_PASSWORD=

# ── Optional: Google Cloud Deployment ────────────────────────────────────────
GCLOUD_PROJECT_ID=

# ── Optional: Alerting ───────────────────────────────────────────────────────
ALERT_EMAIL=
ALERT_WEBHOOK=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
HEALTH_ENDPOINT=

# ── Optional: Twilio SMS Auto-Send ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
