# ============================================================================
# secrets.toml.example
#
# This file is the TEMPLATE for what you'll paste into Streamlit Community
# Cloud's secrets UI (Settings → Secrets). Do NOT commit a real secrets.toml —
# .streamlit/secrets.toml is in .gitignore for a reason.
#
# On Streamlit Cloud:
#   Advanced settings → Secrets → paste the contents below with your real values.
#
# Locally, you don't need this file at all — your .env handles everything.
# ============================================================================

YOUTUBE_API_KEY       = "AIza..."
SUPABASE_URL          = "https://your-project-id.supabase.co"
SUPABASE_SERVICE_KEY  = "eyJ..."
GEMINI_API_KEY        = "AIza..."

# Optional: model overrides (defaults are fine)
GEMINI_CHAT_MODEL  = "gemini-2.5-flash"
GEMINI_EMBED_MODEL = "text-embedding-004"

# Password gate — anyone without this password cannot use the app.
# Pick something you'd share with friends but not strangers.
APP_PASSWORD = "pick-a-password"
